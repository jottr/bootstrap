# 1Password references only, one per line: VAR=op://<vault>/<item-uuid>/<field>
# This file never holds a value. Commands that need one resolve it at runtime:
#   op run --env-file=secrets.env -- <command>
# Use the item UUID, not the item name: a name can change, a UUID cannot.
#   op item list --format json | jq -r '.[] | select(.title=="<name>") | .id'
# The op-references-only pre-commit hook rejects every other line.
