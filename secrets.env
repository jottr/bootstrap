# 1Password secret references ONLY — never real values.
# Resolved at runtime by `op run --env-file=secrets.env -- <cmd>` (see the
# `container` justfile module). The left-hand name is the env var that gets set
# in the process; it must match what the consumer expects.

# Supplies Claude Code's auth token to the dev container via devcontainer
# remoteEnv (`just container claude` / `shell`).
CLAUDE_CODE_OAUTH_TOKEN="op://APIs/claude-code/CLAUDE_CODE_OAUTH_TOKEN"
